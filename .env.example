# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude (https://platform.claude.com → API keys). Optional: without it, Shoppiee
# falls back to rule-based explanations and keyword-based screenshot matching.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
CLAUDE_MODEL=

# Product data provider: "mock" for now (SerpAPI provider can be plugged in later)
DATA_PROVIDER=mock
